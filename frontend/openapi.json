{
  "openapi": "3.1.0",
  "info": {
    "title": "Opticore API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Liveness + database check.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Database not reachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/projects": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "List Projects",
        "operationId": "list_projects",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProjectRead"
                  },
                  "type": "array",
                  "title": "Response List Projects"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "projects"
        ],
        "summary": "Create Project",
        "operationId": "create_project",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "Get Project",
        "operationId": "get_project",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "projects"
        ],
        "summary": "Update Project",
        "operationId": "update_project",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Project Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "projects"
        ],
        "summary": "Delete Project",
        "operationId": "delete_project",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}/files": {
      "get": {
        "tags": [
          "files"
        ],
        "summary": "List Files",
        "operationId": "list_files",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProjectFileRead"
                  },
                  "title": "Response List Files"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "files"
        ],
        "summary": "Upload File",
        "description": "Store the file; KML/KMZ/DXF/DWG are then imported in the background (status `processing`).",
        "operationId": "upload_file",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Project Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_file"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectFileRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}/files/{file_id}/process": {
      "post": {
        "tags": [
          "files"
        ],
        "summary": "Process File",
        "description": "Re-run processing of a file (e.g. after a failure or an importer update).",
        "operationId": "process_file",
        "parameters": [
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "File Id"
            }
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectFileRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}/files/{file_id}": {
      "delete": {
        "tags": [
          "files"
        ],
        "summary": "Delete File",
        "operationId": "delete_file",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Project Id"
            }
          },
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "File Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}/layers": {
      "get": {
        "tags": [
          "layers"
        ],
        "summary": "Get Layers",
        "description": "Everything to draw on the project map: boundary + imported features (EPSG:4326 GeoJSON).",
        "operationId": "get_layers",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectLayers"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}/buildings": {
      "get": {
        "tags": [
          "buildings"
        ],
        "summary": "Get Buildings",
        "description": "Buildings from the latest imported drawing, with review status (EPSG:4326 GeoJSON).",
        "operationId": "get_buildings",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildingLayer"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_file": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_file"
      },
      "BoundaryPosition": {
        "type": "string",
        "enum": [
          "inside",
          "crossing",
          "outside"
        ],
        "title": "BoundaryPosition"
      },
      "BoundaryRead": {
        "properties": {
          "geometry": {
            "$ref": "#/components/schemas/GeoJsonGeometry"
          },
          "source_file_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source File Id"
          },
          "area_m2": {
            "type": "number",
            "title": "Area M2",
            "description": "Measured in EPSG:32636 (UTM 36N)"
          },
          "perimeter_m": {
            "type": "number",
            "title": "Perimeter M",
            "description": "Measured in EPSG:32636 (UTM 36N)"
          }
        },
        "type": "object",
        "required": [
          "geometry",
          "source_file_id",
          "area_m2",
          "perimeter_m"
        ],
        "title": "BoundaryRead"
      },
      "BuildingLayer": {
        "properties": {
          "source_file_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source File Id",
            "description": "Drawing the buildings were imported from"
          },
          "provisional": {
            "type": "boolean",
            "title": "Provisional",
            "description": "True while the CAD reading rules are not approved (status TBC)"
          },
          "summary": {
            "$ref": "#/components/schemas/BuildingSummary"
          },
          "buildings": {
            "items": {
              "$ref": "#/components/schemas/BuildingRead"
            },
            "type": "array",
            "title": "Buildings"
          },
          "orphan_labels": {
            "items": {
              "$ref": "#/components/schemas/OrphanLabelRead"
            },
            "type": "array",
            "title": "Orphan Labels"
          }
        },
        "type": "object",
        "required": [
          "source_file_id",
          "provisional",
          "summary",
          "buildings",
          "orphan_labels"
        ],
        "title": "BuildingLayer"
      },
      "BuildingRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Codes",
            "description": "Building IDs whose label lies inside this polygon"
          },
          "status": {
            "$ref": "#/components/schemas/BuildingStatus"
          },
          "boundary_position": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BoundaryPosition"
              },
              {
                "type": "null"
              }
            ],
            "description": "None when the project has no boundary"
          },
          "area_m2": {
            "type": "number",
            "title": "Area M2",
            "description": "Measured in EPSG:32636 (UTM 36N)"
          },
          "geometry": {
            "$ref": "#/components/schemas/GeoJsonGeometry"
          }
        },
        "type": "object",
        "required": [
          "id",
          "codes",
          "status",
          "boundary_position",
          "area_m2",
          "geometry"
        ],
        "title": "BuildingRead"
      },
      "BuildingStatus": {
        "type": "string",
        "enum": [
          "ok",
          "multiple_ids",
          "no_id"
        ],
        "title": "BuildingStatus"
      },
      "BuildingSummary": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "ok": {
            "type": "integer",
            "title": "Ok"
          },
          "multiple_ids": {
            "type": "integer",
            "title": "Multiple Ids"
          },
          "no_id": {
            "type": "integer",
            "title": "No Id"
          },
          "orphan_ids": {
            "type": "integer",
            "title": "Orphan Ids"
          },
          "inside": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Inside"
          },
          "crossing": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Crossing"
          },
          "outside": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outside"
          }
        },
        "type": "object",
        "required": [
          "total",
          "ok",
          "multiple_ids",
          "no_id",
          "orphan_ids",
          "inside",
          "crossing",
          "outside"
        ],
        "title": "BuildingSummary"
      },
      "FeatureRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "source_file_id": {
            "type": "string",
            "format": "uuid",
            "title": "Source File Id"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "geometry": {
            "$ref": "#/components/schemas/GeoJsonGeometry"
          }
        },
        "type": "object",
        "required": [
          "id",
          "source_file_id",
          "name",
          "description",
          "geometry"
        ],
        "title": "FeatureRead"
      },
      "FileKind": {
        "type": "string",
        "enum": [
          "kml",
          "kmz",
          "dxf",
          "dwg",
          "survey_xlsx",
          "other"
        ],
        "title": "FileKind"
      },
      "FileStatus": {
        "type": "string",
        "enum": [
          "uploaded",
          "processing",
          "processed",
          "failed"
        ],
        "title": "FileStatus"
      },
      "GeoJsonGeometry": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "coordinates": {
            "items": {},
            "type": "array",
            "title": "Coordinates"
          }
        },
        "type": "object",
        "required": [
          "type",
          "coordinates"
        ],
        "title": "GeoJsonGeometry",
        "description": "GeoJSON geometry in EPSG:4326 (lon, lat)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "unreachable"
            ],
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "Health"
      },
      "OrphanLabelRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "geometry": {
            "$ref": "#/components/schemas/GeoJsonGeometry"
          }
        },
        "type": "object",
        "required": [
          "id",
          "code",
          "geometry"
        ],
        "title": "OrphanLabelRead",
        "description": "A Building ID label that is not inside any building polygon."
      },
      "ProjectCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ProjectCreate"
      },
      "ProjectFileRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "project_id": {
            "type": "string",
            "format": "uuid",
            "title": "Project Id"
          },
          "kind": {
            "$ref": "#/components/schemas/FileKind"
          },
          "original_filename": {
            "type": "string",
            "title": "Original Filename"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "status": {
            "$ref": "#/components/schemas/FileStatus"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time",
            "title": "Uploaded At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "project_id",
          "kind",
          "original_filename",
          "size_bytes",
          "sha256",
          "status",
          "error",
          "note",
          "uploaded_at"
        ],
        "title": "ProjectFileRead"
      },
      "ProjectLayers": {
        "properties": {
          "boundary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BoundaryRead"
              },
              {
                "type": "null"
              }
            ]
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/FeatureRead"
            },
            "type": "array",
            "title": "Features"
          }
        },
        "type": "object",
        "required": [
          "boundary",
          "features"
        ],
        "title": "ProjectLayers"
      },
      "ProjectRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "status": {
            "$ref": "#/components/schemas/ProjectStatus"
          },
          "file_count": {
            "type": "integer",
            "title": "File Count"
          },
          "has_boundary": {
            "type": "boolean",
            "title": "Has Boundary"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "status",
          "file_count",
          "has_boundary",
          "created_at",
          "updated_at"
        ],
        "title": "ProjectRead"
      },
      "ProjectStatus": {
        "type": "string",
        "enum": [
          "draft",
          "active",
          "archived"
        ],
        "title": "ProjectStatus"
      },
      "ProjectUpdate": {
        "properties": {
          "name": {
            "anyOf": [
              {
